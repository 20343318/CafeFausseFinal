# Copy these names into your local shell or an untracked database/.env file.
# Do not commit passwords or connection strings containing credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=cafe_fausse_dev
PGUSER=your_local_postgres_role
# Set PGPASSWORD only in your local environment when your server requires it.

# rebuild.ps1 accepts only development, test, or demo and requires YES exactly.
CAFE_FAUSSE_ENVIRONMENT=development
CAFE_FAUSSE_ALLOW_RESET=YES

# Optional when psql is not on PATH.
# CAFE_FAUSSE_PSQL=C:\Program Files\PostgreSQL\18\bin\psql.exe

# Development/test session bounds used when PGOPTIONS is otherwise unset.
PGOPTIONS=-c lock_timeout=5000 -c statement_timeout=60000
