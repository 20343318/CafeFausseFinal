{
  "name": "cafe-fausse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shell": "vitest run src/test/AppRoutes.test.jsx src/test/SiteHeader.test.jsx src/test/AppErrorBoundary.test.jsx",
    "test:gallery": "vitest run src/test/gallery-discovery.test.js src/test/GalleryPage.test.jsx src/test/GalleryLightbox.test.jsx",
    "test:reservations": "vitest run src/test/validation.test.js src/test/ReservationFeature.test.jsx",
    "test:newsletter": "vitest run src/test/NewsletterPreferences.test.jsx",
    "test:mocked-flows": "vitest run src/test/ContractMockSemantics.test.js src/test/MockedPageFlows.test.jsx",
    "test:integration": "vitest run src/test/LiveOperations.test.js src/test/CurrentHours.test.jsx src/test/LiveAppIntegration.test.jsx src/test/ViteProxy.test.js",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
